<% var active = hasOld ? Boolean(oldInput.is_active) : (item ? item.is_active : true); %>
<div style="max-width:34rem">
  <p class="pe-eyebrow mb-2">Komunitas</p>
  <h2 class="mb-4"><%= item ? 'Ubah komunitas' : 'Komunitas baru' %></h2>
  <form class="pe-card" method="post" action="<%= item ? '/communities/' + item.id : '/communities' %>">
    <%- csrfField() %>
    <div class="mb-3"><label class="form-label" for="code">Kode</label>
      <input class="form-control pe-mono" id="code" name="code" maxlength="40" value="<%= old('code', item ? item.code : '') %>" required></div>
    <div class="mb-3"><label class="form-label" for="name">Nama</label>
      <input class="form-control" id="name" name="name" maxlength="160" value="<%= old('name', item ? item.name : '') %>" required></div>
    <div class="mb-3"><label class="form-label" for="invited_count">Jumlah mahasiswa yang diundang</label>
      <input class="form-control" type="number" min="0" id="invited_count" name="invited_count" value="<%= old('invited_count', item ? item.invited_count : 0) %>" required></div>
    <div class="form-check mb-4">
      <input class="form-check-input" type="checkbox" id="is_active" name="is_active" value="1" <%= active ? 'checked' : '' %>>
      <label class="form-check-label" for="is_active">Aktif</label>
    </div>
    <div class="d-flex gap-2"><button class="btn btn-dark" type="submit">Simpan</button><a class="btn btn-outline-dark" href="/communities">Batal</a></div>
  </form>
</div>
