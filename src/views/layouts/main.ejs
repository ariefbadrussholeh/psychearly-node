<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'PSYCHEARLY' %> · PSYCHEARLY</title>
  <meta name="description" content="Dashboard peringatan dini kesejahteraan komunitas mahasiswa (prototype berbasis aturan).">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <link href="/assets/css/psychearly.css" rel="stylesheet">
</head>
<body>
<div class="pe-ambient" aria-hidden="true"></div>

<nav class="navbar navbar-expand-md pe-nav sticky-top">
  <div class="container">
    <a class="pe-brand d-inline-flex align-items-center gap-2" href="/"><img class="pe-logo" src="/assets/img/logo.png" alt="" width="32" height="32"><span>PSYCHEARLY</span></a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Buka menu">
      <i class="ph-bold ph-list"></i>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto ms-md-4 gap-md-1">
        <% if (logged) { %>
          <li class="nav-item"><a class="nav-link <%= navPath === 'dashboard' || navPath === 'assessments' ? 'active' : '' %>" href="/dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link <%= navPath === 'individuals' ? 'active' : '' %>" href="/individuals">Individu</a></li>
          <li class="nav-item"><a class="nav-link <%= navPath === 'communities' ? 'active' : '' %>" href="/communities">Komunitas</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= navPath === 'checkin' ? 'active' : '' %>" href="/checkin">Check-in mahasiswa</a></li>
      </ul>
      <div class="d-flex align-items-center gap-3">
        <% if (logged) { %>
          <span class="small text-secondary"><%= userName %></span>
          <form action="/logout" method="post" class="m-0">
            <%- csrfField() %>
            <button class="btn btn-outline-dark btn-sm" type="submit">Keluar</button>
          </form>
        <% } else { %>
          <a class="btn btn-dark btn-sm" href="/login">Masuk pengelola</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<main class="container pe-main">
  <% if (flash.message) { %>
    <div class="alert alert-success" role="status"><%= flash.message %></div>
  <% } %>
  <% if (flash.error) { %>
    <div class="alert alert-danger" role="alert"><%= flash.error %></div>
  <% } %>
  <% if (flash.errors && flash.errors.length) { %>
    <div class="alert alert-danger" role="alert">
      <% [].concat(flash.errors).forEach(function (err) { %><div><%= err %></div><% }) %>
    </div>
  <% } %>

  <%- body %>
</main>

<footer class="pe-footer">
  <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
    <span>PSYCHEARLY adalah prototype peringatan dini berbasis aturan. Bukan alat diagnosis dan bukan layanan darurat.</span>
    <span class="pe-mono">v0.2 prototype</span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/app.js"></script>
<%- scripts %>
</body>
</html>
